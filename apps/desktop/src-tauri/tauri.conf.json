{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Medha",
  "version": "0.1.8",
  "identifier": "app.medha.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:backend && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run prepare:backend -- --release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Medha",
        "width": 1360,
        "height": 840,
        "minWidth": 640,
        "minHeight": 560,
        "dragDropEnabled": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["underWindowBackground"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: blob:; font-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' http://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/medha"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
