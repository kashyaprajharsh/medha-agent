{
  "servers": [
    {
      "server": {
        "name": "io.github.github/github-mcp-server",
        "packages": [
          {
            "identifier": "ghcr.io/github/github-mcp-server:1.12.2",
            "registryType": "oci",
            "runtimeArguments": [
              {
                "description": "Publish the OAuth callback port to loopback so the in-container login callback is reachable",
                "value": "127.0.0.1:8085:8085",
                "name": "-p",
                "type": "named"
              },
              {
                "description": "Fixed OAuth callback port, matching the published port above",
                "value": "GITHUB_OAUTH_CALLBACK_PORT=8085",
                "name": "-e",
                "type": "named"
              },
              {
                "description": "Optional GitHub Personal Access Token. Omit to log in with OAuth on first use.",
                "value": "GITHUB_PERSONAL_ACCESS_TOKEN={token}",
                "variables": {
                  "token": {
                    "format": "string",
                    "isSecret": true
                  }
                },
                "name": "-e",
                "type": "named"
              }
            ],
            "transport": {
              "type": "stdio"
            }
          }
        ],
        "remotes": [
          {
            "headers": [
              {
                "description": "Authorization header with authentication token (PAT or App token)",
                "isSecret": true,
                "name": "Authorization"
              }
            ],
            "type": "streamable-http",
            "url": "https://api.githubcopilot.com/mcp/"
          }
        ]
      }
    },
    {
      "server": {
        "name": "oraios/serena",
        "packages": [
          {
            "identifier": "serena",
            "packageArguments": [
              {
                "format": "string",
                "isRequired": true,
                "name": "--context",
                "type": "named"
              },
              {
                "format": "string",
                "isRequired": true,
                "value": "ide-assistant",
                "type": "positional"
              }
            ],
            "registryType": "pypi",
            "runtimeArguments": [
              {
                "format": "string",
                "isRequired": true,
                "name": "--from",
                "type": "named"
              },
              {
                "format": "string",
                "isRequired": true,
                "value": "git+https://github.com/oraios/serena",
                "type": "positional"
              },
              {
                "format": "string",
                "isRequired": true,
                "value": "serena",
                "type": "positional",
                "valueHint": "cli"
              },
              {
                "format": "string",
                "isRequired": true,
                "value": "start-mcp-server",
                "type": "positional",
                "valueHint": "subcommand"
              }
            ],
            "runtimeHint": "uvx",
            "transport": {
              "type": "stdio"
            },
            "version": "latest"
          }
        ]
      }
    },
    {
      "server": {
        "name": "coplaydev/unity-mcp",
        "packages": [
          {
            "identifier": "uv",
            "registryType": "other",
            "runtimeArguments": [
              {
                "format": "string",
                "isRequired": true,
                "value": "{unity_mcp_server_src}",
                "variables": {
                  "unity_mcp_server_src": {
                    "description": "Absolute path to the Unity MCP Server 'src' folder installed by the Unity package (e.g., macOS: ~/Library/Application Support/UnityMCP/UnityMcpServer/src; Windows: %USERPROFILE%/AppData/Local/UnityMCP/UnityMcpServer/src; Linux: ~/.local/share/UnityMCP/UnityMcpServer/src).",
                    "isRequired": true
                  }
                },
                "name": "--directory",
                "type": "named"
              },
              {
                "format": "string",
                "isRequired": true,
                "value": "run",
                "type": "positional",
                "valueHint": "run"
              },
              {
                "format": "string",
                "isRequired": true,
                "value": "server.py",
                "type": "positional",
                "valueHint": "entrypoint"
              }
            ],
            "runtimeHint": "uv",
            "transport": {
              "type": "stdio"
            },
            "version": "v4.0.0"
          }
        ]
      }
    }
  ]
}
