# medha.lock — the harness artifact (§6). Copy to `medha.lock` in your project
# root to version and share these settings. Absent file = every value below
# stays at its built-in default (nothing changes for a bare checkout).
# Env vars (MEDHA_MAX_TURNS, MEDHA_APPROVE, MEDHA_VERIFY, ...) still work as
# quick session-level overrides on top of whatever this file specifies.

[routing]
# Seat for the provider router (§4.4) once a second model is wired for
# cross-vendor adversarial verification. Not yet consulted by the kernel.
# executor = "openai-compat://localhost:8000/qwen3-coder"
# verifier = "openai-compat://together/llama-3.3-70b"

[budget]
# Per-task ceilings (§4.1/§18.5). Omit any field to leave it unbounded/default.
max_turns = 200
# max_tokens = 5000000
# max_cost_usd = 5.0
# max_wall_s = 7200
# max_parallel_tools = 10000   # concurrent tool calls per turn (§12)

[context]
# Compaction tuning (§4.3). These are the built-in defaults — override only if
# you know what you're changing; get eval-gated once the Gate exists (§4.11).
trigger_ratio = 0.99
microcompact_ratio = 0.60
tail_ratio = 0.20
protect_first_n = 3
protect_last_n = 20
prune_min_tool_tokens = 8000
emergency_ratio = 0.98

[memory]
enabled = true
# Token budget for the memory index kept *in the prompt* every turn (recall is
# injection, not a model-run search). Generous so the working set stays fully
# in-context; raise it if you keep many memories, lower it to save prompt space.
k3_budget_tokens = 3000
write_approval = "user-scope" # "none" | "user-scope" | "all"
stale_after_days = 30

[context_files]
enabled = true
max_chars = 20000
progressive_discovery = true

[lsp]
# Automatic stateful diagnostics/navigation for Rust, TypeScript/JavaScript,
# Python, Go, and C/C++ when their known language-server binary is installed.
# Missing binaries are reported and cached; no package is silently downloaded.
enabled = true
startup_timeout_ms = 10000
request_timeout_ms = 8000
diagnostics_timeout_ms = 4000
diagnostic_settle_ms = 1000
idle_timeout_ms = 600000
restart_backoff_ms = 5000
max_servers = 8
max_results = 200
max_text_chars = 16000
allow_network = false # local servers are network-denied unless explicitly enabled

# Optional project-defined adapter. Medha previews this command and requires
# one-time human approval through `lsp.start` before it can execute.
# [[lsp.servers]]
# id = "zls"
# languages = ["zig"]
# command = ["zls"]
# root_markers = ["build.zig", ".git"]
# trust = "workspace"

[policy]
# Tool classes requiring human approval before execution (§4.7). File writes
# need a nod by default; shell is instead gated by the deterministic
# dangerous-pattern scanner (blocks rm -rf/, sudo, credential reads, etc.) so
# ordinary commands like `open` or `ls` don't need approval. Add "shell.exec"
# here too if you want every shell command to ask first. [] = fully autonomous.
approve = ["fs.write", "fs.edit", "skill.save"]

[sandbox]
# Execution isolation for shell/build/VCS commands (§4.8). Makes the containment
# posture part of the portable harness artifact. Zero external dependencies —
# uses the OS-native sandbox (macOS Seatbelt; Linux Landlock later), not Docker.
#   backend = "native"  (default) → OS jail: writes confined to the workspace,
#             temp, and dev caches; anything else (e.g. ~/.ssh) is blocked.
#           = "host"              → no OS isolation (scanner + approval only).
#           = "container"         → run each command in a throwaway docker/podman
#             container (opt-in heavy tier; shells out, no daemon linked in).
#             Requires `image`. Host env is NOT forwarded, so API keys stay put.
#           = "ssh"               → run each command on a remote `host` (remote
#             exec, not local isolation; assumes the workspace exists there).
# Override per-session with `--no-sandbox` or MEDHA_SANDBOX=host|native.
# Misconfigured container/ssh falls back to the native jail with a warning.
backend = "native"
# Container tier (only used when backend = "container"):
# image = "rust:1"          # must contain the toolchain your commands need
# runtime = "docker"        # or "podman"; auto-detected if unset
# memory = "2g"             # optional resource caps
# pids = 512
# SSH tier (only used when backend = "ssh"):
# host = "user@devbox"
# remote_dir = "/home/user/project"
# network: "allow" (default — cargo/npm/etc. can fetch) or "deny" (block all
# network from confined commands — stronger containment for untrusted work).
network = "allow"
# Extra absolute paths the jail may write to, beyond workspace + temp + the
# built-in dev caches (~/.cargo, ~/.rustup, ~/.npm, ~/.cache, ...).
# extra_writable = ["/path/to/shared/build/dir"]

[ui]
# TUI presentation defaults (configure reasoning live with /reasoning).
show_thinking = false
full_transparency = false

[verify]
# Deterministic check run after file-modifying turns (§4.7). Empty = none.
# command = "cargo check"

[gate]
# Eval scenario defaults (§4.11–4.12). `seeds` must be 1–100; counts above 10
# require an explicit `medha gate ... --yes` acknowledgement because every seed
# may spend the scenario's full model budget.
scenarios_dir = "scenarios"
pass_threshold = 1.0 # finite value greater than 0.0 and at most 1.0
seeds = 1
regression_epsilon = 0.0

[reasoning]
# Request-side thinking control for reasoning-capable models (§4.4) — sent as
# chat_template_kwargs (vLLM/SGLang-style servers). Both fields optional; a
# server/model without a matching knob just ignores what it doesn't support.
# Live override: /reasoning in a TUI session.
# enabled = true
# effort = "medium"   # "low" | "medium" | "high" — not every server has all three
# stream = true       # false → one blocking request per turn (whole reply at once).
#                     # Use when a gateway only sends reasoning in the non-streamed
#                     # response. Live override: /stream.
