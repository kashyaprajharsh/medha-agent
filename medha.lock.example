# Copy to `medha.lock` in the project root to share portable settings.
# Environment variables remain session-level overrides.

[routing]
# executor = "openai-compat://localhost:8000/qwen3-coder"
# verifier = "openai-compat://together/llama-3.3-70b"

[budget]
# Per-task ceilings; omitted fields use built-in defaults.
max_turns = 200
# max_tokens = 5000000
# max_cost_usd = 5.0
# max_wall_s = 7200
# max_parallel_tools = 10000   # concurrent tool calls per turn

[context]
# Compaction thresholds and protected transcript regions.
trigger_ratio = 0.99
microcompact_ratio = 0.60
tail_ratio = 0.20
protect_first_n = 3
protect_last_n = 20
prune_min_tool_tokens = 8000
emergency_ratio = 0.98

[memory]
enabled = true
# Token budget for the memory index injected into each prompt.
k3_budget_tokens = 3000
write_approval = "user-scope" # "none" | "user-scope" | "all"
stale_after_days = 30

[context_files]
enabled = true
max_chars = 20000
progressive_discovery = true

[lsp]
# Language servers start only from installed binaries; none are downloaded.
enabled = true
startup_timeout_ms = 10000
request_timeout_ms = 8000
diagnostics_timeout_ms = 4000
diagnostic_settle_ms = 1000
idle_timeout_ms = 600000
restart_backoff_ms = 5000
max_servers = 8
max_results = 200
max_text_chars = 16000
allow_network = false # local servers are network-denied unless explicitly enabled

# Project-defined adapters require approval before execution.
# [[lsp.servers]]
# id = "zls"
# languages = ["zig"]
# command = ["zls"]
# root_markers = ["build.zig", ".git"]
# trust = "workspace"

[policy]
# Otherwise-allowed tool classes that still require human approval.
# Add "shell.exec" to require approval for every shell command.
approve = ["fs.write", "fs.edit", "multi_edit", "skill.save"]

[sandbox]
# Execution isolation for shell, build, and VCS commands.
#   backend = "native"  (default) → OS jail: writes confined to the workspace,
#             temp, and dev caches; anything else (e.g. ~/.ssh) is blocked.
#           = "host"              → no OS isolation (scanner + approval only).
#           = "container"         → run each command in a throwaway docker/podman
#             container (opt-in heavy tier; shells out, no daemon linked in).
#             Requires `image`. Host env is NOT forwarded, so API keys stay put.
#           = "ssh"               → run on `host`; this is remote execution,
#             not local isolation, and assumes the workspace exists there.
# Override per-session with `--no-sandbox` or MEDHA_SANDBOX=host|native.
# Misconfigured container/ssh falls back to the native jail with a warning.
backend = "native"
# Container tier (only used when backend = "container"):
# image = "rust:1"          # must contain the toolchain your commands need
# runtime = "docker"        # or "podman"; auto-detected if unset
# memory = "2g"             # optional resource caps
# pids = 512
# SSH tier (only used when backend = "ssh"):
# host = "user@devbox"
# remote_dir = "/home/user/project"
# network: "deny" (default — block all network from confined commands) or
# "allow" (opt in when cargo/npm/etc. need to fetch).
network = "deny"
# Extra absolute paths the jail may write to, beyond workspace + temp + the
# built-in dev caches (~/.cargo, ~/.rustup, ~/.npm, ~/.cache, ...).
# extra_writable = ["/path/to/shared/build/dir"]

[ui]
# Initial TUI presentation defaults.
show_thinking = false
full_transparency = false

[verify]
# Optional deterministic check after file-modifying turns.
# command = "cargo check"

[gate]
# Gate scenario defaults. `seeds` must be 1–100; counts above 10
# require an explicit `medha gate ... --yes` acknowledgement because every seed
# may spend the scenario's full model budget.
scenarios_dir = "scenarios"
pass_threshold = 1.0 # finite value greater than 0.0 and at most 1.0
seeds = 1
regression_epsilon = 0.0

[reasoning]
# Optional request-side reasoning controls; unsupported knobs are ignored.
# Live override: /reasoning in a TUI session.
# enabled = true
# effort = "medium"   # "low" | "medium" | "high" — not every server has all three
# stream = true       # false → one blocking request per turn (whole reply at once).
#                     # Use when a gateway only sends reasoning in the non-streamed
#                     # response. Live override: /stream.
